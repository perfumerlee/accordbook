// Private Guide Draft Web App. Configure GUIDE_DRAFT_FOLDER_ID and GUIDE_DRAFT_OPERATOR_KEY_HASH.
const GUIDE_FORMAT_ = 'accordbook-guide-draft';
function json_(value) { return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON); }
function validId_(id) { return typeof id === 'string' && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(id); }
function auth_(key) { const expected = String(PropertiesService.getScriptProperties().getProperty('GUIDE_DRAFT_OPERATOR_KEY_HASH') || ''); if (!expected || !key) return false; const digest = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, key, Utilities.Charset.UTF_8).map(b => ('0' + (b < 0 ? b + 256 : b).toString(16)).slice(-2)).join(''); return digest === expected; }
function folder_(id) { const root = DriveApp.getFolderById(String(PropertiesService.getScriptProperties().getProperty('GUIDE_DRAFT_FOLDER_ID') || '')); const it = root.getFoldersByName(id); return it.hasNext() ? it.next() : root.createFolder(id); }
function head_(id) { const files = folder_(id).getFilesByName('head.json'); return files.hasNext() ? JSON.parse(files.next().getBlob().getDataAsString()) : null; }
function doPost(e) { try { const body = JSON.parse(e.postData.contents || '{}'); if (!auth_(body.operatorKey)) return json_({ ok: false, code: 'AUTH_FAILED' }); if (body.action === 'checkAuth') return json_({ ok: true }); if (!validId_(body.guideId)) return json_({ ok: false, code: 'INVALID_DRAFT' }); const folder = folder_(body.guideId); if (body.action === 'getDraft') { const draft = head_(body.guideId); return draft ? json_({ ok: true, draft }) : json_({ ok: false, code: 'NO_DRAFT' }); } if (body.action === 'deleteDraft') { const files = folder.getFilesByName('head.json'); while (files.hasNext()) files.next().setTrashed(true); return json_({ ok: true }); } if (body.action === 'saveDraft') { const raw = JSON.stringify(body.document || {}); if (raw.length > 900000 || !body.document || body.document.guideId !== body.guideId) return json_({ ok: false, code: 'INVALID_DRAFT' }); const lock = LockService.getScriptLock(); lock.waitLock(10000); try { const current = head_(body.guideId); if (current && current.revision !== body.expectedRevision) return json_({ ok: false, code: 'REVISION_CONFLICT' }); const revision = current ? current.revision + 1 : 1; const draft = { format: GUIDE_FORMAT_, formatVersion: 1, guideId: body.guideId, revision, updatedAt: new Date().toISOString(), basePublishedFingerprint: String(body.basePublishedFingerprint || ''), document: body.document }; const files = folder.getFilesByName('head.json'); if (files.hasNext()) files.next().setContent(JSON.stringify(draft, null, 2)); else folder.createFile('head.json', JSON.stringify(draft, null, 2), MimeType.PLAIN_TEXT); return json_({ ok: true, draft }); } finally { lock.releaseLock(); } } return json_({ ok: false, code: 'INVALID_DRAFT' }); } catch (_) { return json_({ ok: false, code: 'INVALID_DRAFT' }); } }
