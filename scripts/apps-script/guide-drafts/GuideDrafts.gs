// Private Guide Draft Web App. Configure GUIDE_DRAFT_FOLDER_ID and GUIDE_DRAFT_OPERATOR_KEY_HASH.
const GUIDE_FORMAT_ = 'accordbook-guide-draft';
function json_(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON)}
function validId_(v){return typeof v==='string'&&/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(v)}
function auth_(key){const expected=String(PropertiesService.getScriptProperties().getProperty('GUIDE_DRAFT_OPERATOR_KEY_HASH')||'');if(!expected||!key)return false;const digest=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,key,Utilities.Charset.UTF_8).map(b=>('0'+(b<0?b+256:b).toString(16)).slice(-2)).join('');return digest===expected}
function folder_(id){const root=DriveApp.getFolderById(String(PropertiesService.getScriptProperties().getProperty('GUIDE_DRAFT_FOLDER_ID')||''));const it=root.getFoldersByName(id);return it.hasNext()?it.next():root.createFolder(id)}
function revisions_(folder){const it=folder.getFoldersByName('revisions');return it.hasNext()?it.next():folder.createFolder('revisions')}
function head_(id){const it=folder_(id).getFilesByName('head.json');return it.hasNext()?JSON.parse(it.next().getBlob().getDataAsString()):null}
function meta_(d){return{revision:d.revision,updatedAt:d.updatedAt,basePublishedFingerprint:d.basePublishedFingerprint}}
function doPost(e){try{const rawRequest=e.postData.contents||'{}';if(publishRequestBytes_(rawRequest)>6779294)return json_({ok:false,code:'ASSET_AGGREGATE_TOO_LARGE'});const body=JSON.parse(rawRequest);if(!auth_(body.operatorKey))return json_({ok:false,code:'AUTH_FAILED'});if(body.action==='checkAuth')return json_({ok:true});if(!validId_(body.guideId))return json_({ok:false,code:'INVALID_DRAFT'});if(body.action==='upgradeLegacyDraft')return upgradeLegacyDraftServer_(body);if(body.action==='getPublishedGuide')return getPublishedGuideServer_(body.guideId);if(body.action==='refreshDraft')return refreshDraftServer_(body);if(body.action==='prepareAssetPublish'){if(!Object.prototype.hasOwnProperty.call(PUBLISH_GUIDE_PATHS_,body.guideId))return json_({ok:false,code:'INVALID_DRAFT'});const d=head_(body.guideId);return d?json_({ok:true,assetPublishProtocol:1,draft:d}):json_({ok:false,code:'NO_DRAFT'})}if(body.action==='publishGuide')return publishGuideServer_(body);const folder=folder_(body.guideId);if(body.action==='getDraft'){const d=head_(body.guideId);return d?json_({ok:true,draft:d}):json_({ok:false,code:'NO_DRAFT'})}if(body.action==='listDraftRevisions'){const out=[],it=revisions_(folder).getFiles();while(it.hasNext()){const f=it.next();const m=/^r(\d{6})\.json$/.exec(f.getName());if(m){const d=JSON.parse(f.getBlob().getDataAsString());out.push(meta_(d))}}out.sort((a,b)=>b.revision-a.revision);return json_({ok:true,revisions:out.slice(0,5)})}if(body.action==='getDraftRevision'){if(!Number.isInteger(body.revision)||body.revision<1)return json_({ok:false,code:'REVISION_NOT_FOUND'});const f=revisions_(folder).getFilesByName('r'+String(body.revision).padStart(6,'0')+'.json');return f.hasNext()?json_({ok:true,draft:JSON.parse(f.next().getBlob().getDataAsString())}):json_({ok:false,code:'REVISION_NOT_FOUND'})}if(body.action==='deleteDraft'){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const files=folder.getFiles();while(files.hasNext())files.next().setTrashed(true);const rit=revisions_(folder).getFiles();while(rit.hasNext())rit.next().setTrashed(true);return json_({ok:true})}finally{lock.releaseLock()}}if(body.action==='saveDraft'){const raw=JSON.stringify(body.document||{});if(raw.length>900000||!body.document||body.document.guideId!==body.guideId)return json_({ok:false,code:'INVALID_DRAFT'});const lock=LockService.getScriptLock();lock.waitLock(10000);try{const current=head_(body.guideId);if(current&&current.revision!==body.expectedRevision)return json_({ok:false,code:'REVISION_CONFLICT',currentRevision:current.revision});const revision=current?current.revision+1:1;const d=draftEnvelopeFromSave_(body,body.guideId,revision);if(!d)return json_({ok:false,code:'INVALID_DRAFT'});revisions_(folder).createFile('r'+String(revision).padStart(6,'0')+'.json',JSON.stringify(d,null,2),MimeType.PLAIN_TEXT);const heads=folder.getFilesByName('head.json');if(heads.hasNext())heads.next().setContent(JSON.stringify(d,null,2));else folder.createFile('head.json',JSON.stringify(d,null,2),MimeType.PLAIN_TEXT);const all=[],it=revisions_(folder).getFiles();while(it.hasNext()){const f=it.next(),m=/^r(\d{6})\.json$/.exec(f.getName());if(m)all.push({file:f,revision:Number(m[1])})}all.sort((a,b)=>b.revision-a.revision).slice(5).forEach(x=>x.file.setTrashed(true));return json_({ok:true,draft:d})}finally{lock.releaseLock()}}return json_({ok:false,code:'INVALID_DRAFT'})}catch(_){return json_({ok:false,code:'INVALID_DRAFT'})}}
