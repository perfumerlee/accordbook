# Anonymous, read-only Formula Drop public API Web App URL.
# AI Review is opt-in. VITE values are bundled public configuration, never secrets.
# Never put beta tokens or OpenAI keys in VITE_* variables.
# Local development example:
VITE_AI_ENABLED=false
VITE_AI_ENDPOINT=
# Set only to a read-verified Cloud Run AI_INPUT_BYTES value; unset keeps Experiment AI sending disabled.
VITE_EXPERIMENT_AI_INPUT_BYTES=
# Production Pages builds set the approved endpoint explicitly in the workflow.
# The beta token is entered at runtime and held in memory only.
VITE_FORMULA_DROP_PUBLIC_API_URL=https://script.google.com/macros/s/AKfycbz33sWgS2MemBpx8FAcqzV-Fb6K3PSI4EUYhRhG64nXXCT6SujCDKHQbJDYfhIEB9PsQA/exec
